{
  "schema": 1,
  "surfaces": {
    "app": {
      "paths": [
        "index.html",
        "styles.css",
        "css/**",
        "js/**",
        "i18n.js"
      ]
    }
  },
  "protected": [
    "tests/**"
  ],
  "commands": {
    "fast": "npm test",
    "snapshot": ""
  },
  "style": {
    "theme_paths": []
  },
  "limits": {
    "max_files": 25,
    "max_lines": 2500
  }
}
